# Google Gemini API Key (Required for live AI generation; falls back to built-in 100 topics & demo mode if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Cloud Run automatically injects PORT=8080)
PORT=8080

# Optional: Gemini Model Name
GEMINI_MODEL=gemini-2.5-flash

# Browser-visible Google Maps JavaScript API key for the optional Street View co-walk.
# Restrict by HTTP referrer (localhost and actual Cloud Run host) and Maps JavaScript API.
# Never use GEMINI_API_KEY for this value.
GOOGLE_MAPS_BROWSER_API_KEY=your_restricted_maps_browser_key_here

# Optional TURN relay: comma-separated turn:/turns: URLs.
# Server-only secret; never commit a real value. Expiring client credentials are derived.
TURN_URLS=
TURN_SHARED_SECRET=

# Vertex AI and ENABLE_SHARED_WALK are not supported by the current code.
# GEMINI_MODEL above is the code default, not a statement of production configuration.
