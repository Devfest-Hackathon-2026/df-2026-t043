# Google Gemini API Key (Required for live AI generation; falls back to built-in 100 topics & demo mode if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Cloud Run automatically injects PORT=8080)
PORT=8080

# Optional: Gemini Model Name
GEMINI_MODEL=gemini-2.5-flash

# Optional: use Vertex AI with Application Default Credentials instead of the Gemini API key.
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=asia-northeast1

# Browser-visible Google Maps JavaScript API key for the optional Street View co-walk.
# Restrict by HTTP referrer (localhost and actual Cloud Run host) and Maps JavaScript API.
# Never use GEMINI_API_KEY for this value.
GOOGLE_MAPS_BROWSER_API_KEY=your_restricted_maps_browser_key_here
ENABLE_SHARED_WALK=false

# TURN relay credentials for networks that cannot connect directly.
# These client credentials are returned to call participants. Never use an API key here.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Alternatively, generate expiring TURN credentials with a server-only shared secret.
TURN_SHARED_SECRET=
